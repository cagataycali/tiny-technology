# ─────────────────────────────────────────────────────────────────────────
# Auth & platform (required for a working local instance)
# ─────────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_JWT_SECRET=          # HMAC secret for session/CLI JWTs — any long random string
INTERNAL_API_KEY=         # shared secret with the Cloudflare worker (must match wrangler secret)

# Worker base URL — defaults to https://plugin.tiny.technology if unset
TINY_WORKER_URL=
# Self URL for edge→node internal calls (the /api/run-tool sandbox host)
NEXT_PUBLIC_APP_URL=

# ─────────────────────────────────────────────────────────────────────────
# Default model (server-side fallback when the user hasn't brought a key).
# Without one, only BYOK requests work — the "Tiny (free)" preset shows a
# "No API key configured" error (preflight, not a crash).
# Pick ONE provider's key; the rest are optional per-provider fallbacks.
# ─────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_ID=          # optional, default gpt-5.6-luna
TINY_MODEL_PROVIDER=      # optional, default 'openai' — pins the default provider

# Other provider fallback keys (all optional — BYOK covers these at runtime)
GEMINI_API_KEY=           # or GOOGLE_API_KEY
GEMINI_MODEL_ID=
AWS_BEARER_TOKEN_BEDROCK= # Bedrock API key (Console → Bedrock → API keys)
BEDROCK_REGION=           # or AWS_REGION; default us-west-2
BEDROCK_MODEL_ID=
AI_GATEWAY_API_KEY=       # Vercel AI Gateway
AI_GATEWAY_MODEL_ID=
# Extra JSON merged into every model request (same shape as the Strands CLI),
# e.g. {"anthropic_beta":["context-1m-2025-08-07"]} — clients can override
# per-request via the x-tiny-model-additional-fields header
STRANDS_ADDITIONAL_REQUEST_FIELDS=

# ─────────────────────────────────────────────────────────────────────────
# Rate limiting (per-IP 50/day by default). Without these it fails OPEN (no
# limiting) — fine for local dev, set them in production. Vercel KV / Upstash.
# ─────────────────────────────────────────────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Free-tier daily allowance for requests that use OUR model key (chat, save).
# Default 50; junk/0/negative falls back to 50 (a typo must not remove the wall).
# NEXT_PUBLIC_ because the onboarding + settings copy quotes the same number.
# Deliberately does NOT widen the third-party guards (/api/tiny, /api/login,
# /api/worker) — that window is a brute-force budget, not a free tier.
# Reputation still adds on top: +5/day per point, capped at +200.
NEXT_PUBLIC_FREE_TIER_REQUESTS_PER_DAY=

# ─────────────────────────────────────────────────────────────────────────
# x402 payments (inbound — agents paying a priced tiny). All optional: with
# X402_PAY_TO unset, paid tinys fail closed with 424 and free tinys work.
# ─────────────────────────────────────────────────────────────────────────
# ⚠️ ALSO read by chain/facilitator/server.mjs, which REFUSES TO START without
# it: it's the payee allowlist for /settle. Unset, that service relays ANY
# caller's authorization to ANY payee at our relayer's expense. Comma-separated
# to keep an old + new address valid during a rotation. See chain/settle-policy.mjs.
X402_PAY_TO=              # platform receiving address (the 402 challenge's payTo)
# Which chain this deployment settles on: base | base-sepolia | tiny.
# Unset → the legacy PAYMENTS_TESTNET boolean decides (1 → base-sepolia).
PAYMENTS_NETWORK=
# Facilitator that verifies + settles the EIP-3009 authorization.
# Unset on base/base-sepolia → https://x402.org/facilitator (correct, and what
# tiny.technology runs). ⚠️ REQUIRED on PAYMENTS_NETWORK=tiny: no public
# facilitator can settle a chain you host, so point this at your own
# chain/facilitator/server.mjs (default http://127.0.0.1:8546) or every paid
# tiny 424s. See lib/x402/facilitator.ts.
X402_FACILITATOR_URL=
# Self-hosted chain (chain/ — values from chain/deployment.json)
TINY_CHAIN_ID=
TINY_CHAIN_USDC_ADDRESS=
TINY_CHAIN_RPC_URL=       # default http://127.0.0.1:8545
TINY_CHAIN_EXPLORER_URL=  # optional; no env → no tx links
# Signers on that chain. ⚠️ TINY_CHAIN_DEPLOYER_KEY is TinyUSDC's OWNER, i.e. its
# permanent mint authority — fixed at deploy time, with no revoke. Generate one
# (`openssl rand -hex 32`); never reuse anvil's published test accounts.
TINY_CHAIN_DEPLOYER_KEY=  # mints the faucet's backing reserve; owner-only
# Set to 1 ONLY on a throwaway devnet you can delete. Without it, deploy.mjs
# refuses and the facilitator won't start when their keys are anvil's published
# test accounts (chain/dev-keys.mjs). Never set this on anything real.
TINY_CHAIN_ALLOW_DEV_KEYS=

# ─────────────────────────────────────────────────────────────────────────
# Optional extras
# ─────────────────────────────────────────────────────────────────────────
WEATHER_API_KEY=          # weather context on the 404 page (weatherapi.com)
NEXT_PUBLIC_VAPID_KEY=    # Web Push public key (private half in worker secrets)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=  # /map + map background (browser key, restrict by referrer; code falls back to the shared key)
# BEDROCK_EDGE_DEBUG=1    # verbose ConverseStream frame logging

# ─────────────────────────────────────────────────────────────────────────
# Money out & deposits (all optional — each rail stays off until configured)
# ─────────────────────────────────────────────────────────────────────────
# ⚠️ The withdrawals hot wallet. Only fund it with what you're willing to
# have on a hot key; withdraw answers 424 while unset (or set to a dev key).
PAYOUT_PRIVATE_KEY=
DEPOSIT_ADDRESS=          # where on-chain deposits land; the worker credits Transfer logs to it
# HMAC secret for x402 payment quotes. Falls back to PAYOUT_PRIVATE_KEY as
# HMAC *input* (never on the wire) — set an explicit one to keep them apart.
X402_QUOTE_SECRET=
# Extra hostnames the agent may PAY (comma-separated). tiny.technology's own
# x402 endpoints are always allowed; this guards against injected prompts
# directing balances at attacker URLs.
X402_PAY_ALLOWLIST=
BASE_RPC_URL=             # deposit watching on Base mainnet (public RPC ok)
BASE_SEPOLIA_RPC_URL=     # …and Base Sepolia
NEXT_PUBLIC_MOONPAY_KEY=  # wallet top-up via MoonPay (publishable key)
NEXT_PUBLIC_ONRAMP_APP_ID= # wallet top-up via Coinbase Onramp

# ─────────────────────────────────────────────────────────────────────────
# Operator / fleet endpoints
# ─────────────────────────────────────────────────────────────────────────
OWNER_LOGIN=              # GitHub login allowed to read the device-enrollment list
ENROLL_SECRET=            # machine auth (x-enroll-key) for the UDID auto-enroll job — see ios/BETA_PIPELINE.md
TINY_CHAIN_PUBLIC_BOOTNODES= # comma-separated enodes /api/chain/join hands to joiners
