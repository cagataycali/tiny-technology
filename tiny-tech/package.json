{
  "name": "tiny-tech",
  "version": "0.8.1",
  "description": "tiny.technology for every surface — MCP server + local REPL agent (Strands SDK): identity, cross-agent memory, DMs, tool forge, scheduled jobs, local shell/file/http tools, available to any MCP client or straight from your terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tiny-tech": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node test/live.e2e.mjs",
    "prepublishOnly": "npm run test",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@diskette/dialtone": "^0.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@strands-agents/sdk": "^1.10.0",
    "@types/react": "^19.2.17",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^12.0.2",
    "marked-terminal": "^7.3.0",
    "openai": "^6.48.0",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cagataycali/tiny-technology.git",
    "directory": "tiny-tech"
  },
  "homepage": "https://tiny.technology",
