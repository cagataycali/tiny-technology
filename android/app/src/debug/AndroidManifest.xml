<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- 🧪 Debug-only mock-glasses driver (see MockGlassesReceiver).
             DUMP is signature|privileged: the adb shell can send, apps can't. -->
        <receiver
            android:name="technology.tiny.app.fleet.MockGlassesReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Runs before Application.onCreate — see MockGlassesInitializer. -->
        <provider
            android:name="technology.tiny.app.fleet.MockGlassesInitializer"
            android:authorities="technology.tiny.app.mockglasses"
            android:exported="false" />
    </application>
</manifest>
